APP_NAME="Builder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local-only defaults matching /compose.yaml. Never put real credentials here.
# With Sail, set DB_HOST=postgres and REDIS_HOST=redis (the service names).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=control_plane
DB_USERNAME=control_plane
DB_PASSWORD=control_plane

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Workspaces: disposable environments that run customer code (config/workspaces.php).
# The docker driver is for local development against trusted fixtures only.
# With Sail, use WORKSPACE_DRIVER=runner: the `runner` service stands in for a
# workspace box and never sees this app's code or .env. Set a long random
# WORKSPACE_RUNNER_TOKEN; compose passes it to the runner.
WORKSPACE_DRIVER=docker
WORKSPACE_BOX_PROVIDER=static
WORKSPACE_RUNNER_TOKEN=
WORKSPACE_RUNNER_SOCKET_URL=ws://reverb:8080
# With WORKSPACE_BOX_PROVIDER=pool, the pool can start and delete its own
# machines on a cloud (docs/runner-machines.md). Leave it empty to add them by hand.
WORKSPACE_MACHINES_CLOUD=
WORKSPACE_MACHINES_HETZNER_TOKEN=
WORKSPACE_MACHINES_BOX_IMAGE=
# WORKSPACE_BOX_PROVIDER=docker gives each workspace its own container through
# the `boxes` service (README: Workspaces in Sail). Set a long random token.
WORKSPACE_BOXES_URL=http://boxes:8090
WORKSPACE_BOXES_TOKEN=
# Coding agents in the local driver can read this app's files, including .env.
# Allow them only for trusted apps such as our fixtures.
WORKSPACE_LOCAL_AGENTS=false
WORKSPACE_DOCKER_IMAGE=php:8.4-cli
WORKSPACE_CPUS=2
WORKSPACE_MEMORY_MB=2048
WORKSPACE_COMMANDS_PER_OWNER=2

# Reverb only rings a box runner's doorbell (config/reverb.php). Inside Sail,
# the control plane reaches it at the `reverb` service.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Feature generator (config/builder.php). "reference" replays known-good
# solutions from a manifest directory until the AI agent exists.
BUILDER_GENERATOR=reference
# Where the builder keeps each project's Git repository (config/builder.php).
# BUILDER_PROJECT_REPOSITORIES=
# Keep every repository off this server, for hosts whose disks do not last:
# "github" (a private repository per app in BUILDER_GITHUB_ORGANIZATION, or
# the organization below) or "disk" (a filesystem disk). Empty keeps them
# only on this server's disk.
# BUILDER_PROJECT_STORE=
# BUILDER_PROJECT_STORE_ORGANIZATION=
# BUILDER_PROJECT_STORE_DISK=
# BUILDER_PROJECT_STORE_PREFIX=code
# The app "Start a new app" copies. Leave empty to offer only importing.
# BUILDER_TEMPLATE_PATH=
BUILDER_REFERENCE_SOLUTIONS=fixtures/reference-solutions/customer-app
BUILDER_ACCEPTANCE_PATH=fixtures/acceptance/customer-app

# Construction runs (config/builder.php): the "scripted" driver makes the
# generator's change through the server-side tools; the "sdk" driver plans and
# reviews with the model roles below, builds with a coding agent, and needs the
# provider keys.
# Budgets stop a run and ask the owner how to continue. Keep `runs:reconcile`
# scheduled (schedule:work) so runs whose worker stopped are resumed.
BUILDER_CONSTRUCTION_DRIVER=scripted
BUILDER_RUN_MAX_OPERATIONS=30
BUILDER_RUN_MAX_MINUTES=20
BUILDER_RUN_MAX_REPAIRS=4
BUILDER_DAILY_SPEND_USD=10
# Formatters run on the files a change touched before the checks (JSON list
# of {name, command, extensions, timeout}); empty uses Pint and vp fmt.
BUILDER_CONSTRUCTION_FORMATTERS=

# Project notes live in the database, never in the app's repository. Each
# workspace gets a copy in this hidden directory. Files that a workspace's
# setup makes the first time (a JSON list) are kept encrypted and given to
# every later workspace.
BUILDER_NOTES_DIRECTORY=.product-notes
BUILDER_WORKSPACE_FILES='[".env"]'

# Previews (config/builder.php "preview") serve the project with a change at
# http://{host}.{BUILDER_PREVIEW_DOMAIN}:{BUILDER_PREVIEW_PORT}. *.localhost
# resolves to this machine, so previews work locally with `composer dev`.
BUILDER_PREVIEW_DOMAIN=preview.localhost
BUILDER_PREVIEW_PORT=8000
# Start a preview of each change as soon as it is built. Name a queue to
# start previews on their own worker, in parallel with the checks.
BUILDER_PREVIEW_AUTOMATIC=true
BUILDER_PREVIEW_QUEUE=previews
# Name a queue to run each change's checks on their own worker, so they do
# not wait behind other changes being built.
BUILDER_VERIFICATION_QUEUE=checks
BUILDER_VERIFICATION_RETRIES=2

# Publishing. Apps publish to Laravel Cloud in our organization with one
# click once a Cloud API token and our GitHub organization are set; until
# then owners choose a branch their own hosting deploys from. The GitHub
# token needs to create private repositories and push to them, and Cloud's
# GitHub app must see the organization. Name a database cluster to give
# each app a database in it.
BUILDER_PUBLISH_HOST=laravel_cloud
LARAVEL_CLOUD_API_TOKEN=
LARAVEL_CLOUD_REGION=us-east-2
LARAVEL_CLOUD_DATABASE_CLUSTER=
BUILDER_GITHUB_ORGANIZATION=
BUILDER_GITHUB_TOKEN=

# Or publish to Forge (BUILDER_PUBLISH_HOST=forge), on Hetzner servers that
# Forge manages, from the same GitHub organization. Forge must have access
# to that organization. The Hetzner IDs come from Forge; leave them empty to
# add servers named with the prefix by hand. Copies of each app's database
# go to the Forge storage provider in FORGE_BACKUP_STORAGE.
FORGE_API_TOKEN=
FORGE_ORGANIZATION=
FORGE_SERVER_PREFIX=apps
FORGE_HETZNER_CREDENTIAL=
FORGE_HETZNER_NETWORK=
FORGE_HETZNER_REGION=
FORGE_HETZNER_SIZE=
FORGE_BACKUP_STORAGE=

# Runs and verifications are queued jobs of up to an hour (installs plus the
# full check suite), so the Redis queue must not retry them earlier.
REDIS_QUEUE_RETRY_AFTER=3700

# An idle worker waits on Redis for up to a second, so a preview rebuild
# after an edit starts at once instead of after the worker's 3-second sleep.
REDIS_QUEUE_BLOCK_FOR=1

# Model tiers (config/builder.php): frontier planner, economical coder,
# independent reviewer. Providers come from config/ai.php (for example
# anthropic or openai); empty values fall back to the AI SDK defaults.
BUILDER_PLANNER_PROVIDER=
BUILDER_PLANNER_MODEL=
BUILDER_CODER_PROVIDER=
BUILDER_CODER_MODEL=
BUILDER_REVIEWER_PROVIDER=
BUILDER_REVIEWER_MODEL=
# Providers the planner and reviewer move on to when theirs cannot serve a
# call (down, rate-limited or out of credit), as a JSON list. Only providers
# with a key are tried.
BUILDER_MODEL_FAILOVER='["openai", "anthropic"]'

# Codex's own sandbox (workspace-write) needs Linux user namespaces. Where
# the workspace is a container that does not allow them, use
# danger-full-access: the container is then the boundary.
BUILDER_CODEX_SANDBOX=workspace-write

# Coding agents in the order they are tried. To build on your own ChatGPT
# plan, put codex first, set BUILDER_CODEX_USE_API_KEY=false, and sign in
# once with: CODEX_HOME=<BUILDER_CODEX_HOME> codex login --device-auth
BUILDER_AGENT_ORDER=claude,codex
BUILDER_CODEX_USE_API_KEY=true
BUILDER_CODEX_HOME=

# Prices in USD per million tokens, by model ID, to cost planner and reviewer
# calls, for example {"model-id":{"input":3,"output":15}}. Coding agents
# report their own cost. A change built by a model must have a test for
# each of the brief's verify items unless this is false.
BUILDER_MODEL_PRICES={}
BUILDER_REQUIRE_VERIFY_TESTS=true

# Decisions before building (config/builder.php, decisions): a typed decision
# model (Jev, the laravel/ai "typesafe" provider) classifies each request.
# They run in shadow mode and act on nothing; compare them with what
# happened using `php artisan builder:decisions`. No key, no decisions.
TYPESAFE_API_KEY=
BUILDER_DECISION_PROVIDERS='["typesafe"]'
BUILDER_DECISION_TIMEOUT=10
# Where the tests that the test suite check runs live, and how their file
# names end (JSON lists). A test file elsewhere, or named otherwise, is not
# counted as evidence.
# BUILDER_SUITE_PATHS=["tests/"]
# BUILDER_SUITE_SUFFIXES=["Test.php"]
# Also email the owner when a change is ready, has a question or did not
# work. The builder always shows it in the app.
BUILDER_NOTIFY_BY_EMAIL=false

# Laravel Sail (compose.yaml `laravel.test`). Host ports bind to 127.0.0.1.
# Change them when another project already uses the defaults.
# APP_PORT=80
# VITE_PORT=5173
# WWWUSER=1000
# WWWGROUP=1000

# Operator screens (/operations): comma-separated verified email addresses.
# Empty means nobody can open them.
OPERATIONS_OPERATORS=
