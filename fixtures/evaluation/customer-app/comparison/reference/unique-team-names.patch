@@ -79,4 +79,41 @@ public function test_team_name_is_required()
             ->patch(route('teams.update', $team), ['name' => ''])
             ->assertSessionHasErrors('name');
     }
+
+    public function test_team_cannot_take_the_name_of_another_team_the_user_is_in()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner, 'Acme');
+        $this->createTeamOwnedBy($owner, 'Globex');
+
+        $this->actingAs($owner)
+            ->patch(route('teams.update', $team), ['name' => 'Globex'])
+            ->assertSessionHasErrors('name');
+
+        $this->assertSame('Acme', $team->fresh()->name);
+    }
+
+    public function test_team_can_keep_its_current_name()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner, 'Acme');
+
+        $this->actingAs($owner)
+            ->patch(route('teams.update', $team), ['name' => 'Acme'])
+            ->assertSessionHasNoErrors()
+            ->assertRedirect(route('teams.edit'));
+    }
+
+    public function test_team_may_share_a_name_with_a_team_the_user_is_not_in()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner, 'Acme');
+        $this->createTeamOwnedBy(User::factory()->create(), 'Globex');
+
+        $this->actingAs($owner)
+            ->patch(route('teams.update', $team), ['name' => 'Globex'])
+            ->assertSessionHasNoErrors();
+
+        $this->assertSame('Globex', $team->fresh()->name);
+    }
 }
