@@ -0,0 +1,52 @@
+<?php
+
+namespace Tests\Feature\Teams;
+
+use App\Enums\TeamRole;
+use App\Models\Team;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class CreateTeamTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_users_can_start_a_new_team()
+    {
+        $user = User::factory()->withPersonalTeam()->create();
+        $personalTeam = $user->currentTeam;
+
+        $this->actingAs($user)
+            ->post(route('teams.store'), ['name' => 'Globex'])
+            ->assertSessionHasNoErrors()
+            ->assertRedirect(route('teams.edit'));
+
+        $team = Team::where('name', 'Globex')->firstOrFail();
+
+        $this->assertFalse($team->personal_team);
+        $this->assertSame(TeamRole::Owner, $user->teamRole($team));
+        $this->assertSame(1, $team->members()->count());
+        $this->assertSame($team->id, $user->fresh()->current_team_id);
+        $this->assertSame(TeamRole::Owner, $user->teamRole($personalTeam));
+    }
+
+    public function test_the_team_name_is_required()
+    {
+        $user = User::factory()->withPersonalTeam()->create();
+
+        $this->actingAs($user)
+            ->post(route('teams.store'), ['name' => ''])
+            ->assertSessionHasErrors('name');
+
+        $this->assertSame(1, Team::count());
+    }
+
+    public function test_guests_cannot_start_a_team()
+    {
+        $this->post(route('teams.store'), ['name' => 'Globex'])
+            ->assertRedirect(route('login'));
+
+        $this->assertSame(0, Team::count());
+    }
+}
