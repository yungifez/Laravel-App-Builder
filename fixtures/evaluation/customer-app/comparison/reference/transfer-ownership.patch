+<?php
+
+namespace App\Actions\Teams;
+
+use App\Enums\TeamRole;
+use App\Models\Team;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class TransferTeamOwnership
+{
+    /**
+     * Make the given member the team's owner.
+     *
+     * The previous owner stays in the team as an admin, so the team keeps
+     * exactly one owner.
+     */
+    public function handle(Team $team, User $newOwner): void
+    {
+        DB::transaction(function () use ($team, $newOwner) {
+            $currentOwner = $team->owner();
+
+            if ($currentOwner !== null) {
+                $team->members()->updateExistingPivot($currentOwner->id, ['role' => TeamRole::Admin->value]);
+            }
+
+            $team->members()->updateExistingPivot($newOwner->id, ['role' => TeamRole::Owner->value]);
+        });
+    }
+}
