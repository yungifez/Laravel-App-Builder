+<?php
+
+namespace App\Http\Controllers\Settings;
+
+use App\Actions\Teams\TransferTeamOwnership;
+use App\Http\Controllers\Controller;
+use App\Http\Requests\Settings\TeamOwnerUpdateRequest;
+use App\Models\Team;
+use App\Models\User;
+use Illuminate\Http\RedirectResponse;
+use Inertia\Inertia;
+
+class TeamOwnerController extends Controller
+{
+    /**
+     * Hand ownership of the team to another member.
+     */
+    public function update(TeamOwnerUpdateRequest $request, Team $team, TransferTeamOwnership $transferTeamOwnership): RedirectResponse
+    {
+        $newOwner = User::findOrFail($request->integer('user_id'));
+
+        $transferTeamOwnership->handle($team, $newOwner);
+
+        Inertia::flash('toast', ['type' => 'success', 'message' => __('Ownership transferred.')]);
+
+        return to_route('teams.edit');
+    }
+}
