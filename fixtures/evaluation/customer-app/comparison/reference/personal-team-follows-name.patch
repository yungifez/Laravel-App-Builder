diff --git a/app/Actions/Teams/SyncPersonalTeamName.php b/app/Actions/Teams/SyncPersonalTeamName.php
new file mode 100644
index 0000000..2df28fc
--- /dev/null
+++ b/app/Actions/Teams/SyncPersonalTeamName.php
@@ -0,0 +1,30 @@
+<?php
+
+namespace App\Actions\Teams;
+
+use App\Enums\TeamRole;
+use App\Models\User;
+
+class SyncPersonalTeamName
+{
+    /**
+     * Rename the user's personal team after their current name.
+     */
+    public function handle(User $user): void
+    {
+        $team = $user->teams()
+            ->where('personal_team', true)
+            ->wherePivot('role', TeamRole::Owner->value)
+            ->first();
+
+        $team?->update(['name' => $this->nameFor($user)]);
+    }
+
+    /**
+     * Get the personal team name for the given user.
+     */
+    public function nameFor(User $user): string
+    {
+        return __(':name\'s Team', ['name' => explode(' ', $user->name, 2)[0]]);
+    }
+}
