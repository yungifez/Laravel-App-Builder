 namespace App\Http\Requests\Settings;
 
 use App\Concerns\PasswordValidationRules;
+use App\Enums\TeamRole;
 use Illuminate\Contracts\Validation\ValidationRule;
+use Illuminate\Database\Eloquent\Builder;
 use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Validation\Validator;
 
 class ProfileDeleteRequest extends FormRequest
 {
@@ -21,4 +24,39 @@ public function rules(): array
             'password' => $this->currentPasswordRules(),
         ];
     }
+
+    /**
+     * Get the "after" validation callables for the request.
+     *
+     * People who own a team that other people are in must sort that team
+     * out before deleting their account.
+     *
+     * @return array<int, callable>
+     */
+    public function after(): array
+    {
+        return [
+            function (Validator $validator) {
+                if ($this->ownsTeamWithOtherMembers()) {
+                    $validator->errors()->add(
+                        'account',
+                        __('You own a team that other people are in. Sort that team out before deleting your account.'),
+                    );
+                }
+            },
+        ];
+    }
+
+    /**
+     * Determine if the user owns a team that anyone else belongs to.
+     */
+    protected function ownsTeamWithOtherMembers(): bool
+    {
+        $user = $this->user();
+
+        return $user->teams()
+            ->wherePivot('role', TeamRole::Owner->value)
+            ->whereHas('members', fn (Builder $query) => $query->whereKeyNot($user->id))
+            ->exists();
+    }
 }
