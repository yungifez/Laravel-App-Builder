@@ -0,0 +1,36 @@
+<?php
+
+namespace App\Actions\Teams;
+
+use App\Models\Team;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class DeleteTeam
+{
+    /**
+     * Permanently delete the team and its memberships.
+     *
+     * Anyone working in the team is moved to another team they belong to,
+     * preferring their personal team.
+     */
+    public function handle(Team $team): void
+    {
+        DB::transaction(function () use ($team) {
+            $team->members()->detach();
+
+            User::query()
+                ->where('current_team_id', $team->id)
+                ->each(function (User $user) {
+                    $fallbackTeam = $user->teams()
+                        ->orderByDesc('personal_team')
+                        ->orderBy('teams.id')
+                        ->first();
+
+                    $user->forceFill(['current_team_id' => $fallbackTeam?->id])->save();
+                });
+
+            $team->delete();
+        });
+    }
+}
