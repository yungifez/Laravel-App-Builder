diff --git a/tests/Feature/Teams/DeleteTeamTest.php b/tests/Feature/Teams/DeleteTeamTest.php
new file mode 100644
index 0000000..6e9f031
--- /dev/null
+++ b/tests/Feature/Teams/DeleteTeamTest.php
@@ -0,0 +1,151 @@
+<?php
+
+namespace Tests\Feature\Teams;
+
+use App\Enums\TeamRole;
+use App\Models\Membership;
+use App\Models\Team;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Inertia\Testing\AssertableInertia as Assert;
+use Tests\Concerns\InteractsWithTeams;
+use Tests\TestCase;
+
+class DeleteTeamTest extends TestCase
+{
+    use InteractsWithTeams, RefreshDatabase;
+
+    public function test_owners_can_delete_the_team()
+    {
+        $owner = User::factory()->withPersonalTeam()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $this->addTeamMember($team, TeamRole::Admin);
+        $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($owner)
+            ->delete(route('teams.destroy', $team))
+            ->assertSessionHasNoErrors()
+            ->assertRedirect(route('dashboard'))
+            ->assertInertiaFlash('toast', ['type' => 'success', 'message' => 'Team deleted.']);
+
+        $this->assertModelMissing($team);
+        $this->assertSame(0, Membership::query()->where('team_id', $team->id)->count());
+    }
+
+    public function test_users_working_in_the_deleted_team_move_to_their_personal_team()
+    {
+        $owner = User::factory()->withPersonalTeam()->create();
+        $ownerPersonalTeam = $owner->fresh()->currentTeam;
+        $team = $this->createTeamOwnedBy($owner);
+
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $memberPersonalTeam = $member->currentTeam;
+        $member->forceFill(['current_team_id' => $team->id])->save();
+
+        $otherMember = $this->addTeamMember($team, TeamRole::Admin);
+        $otherTeam = $this->createTeamOwnedBy(User::factory()->create(), 'Other');
+        $otherTeam->members()->attach($otherMember, ['role' => TeamRole::Member->value]);
+        $otherMember->forceFill(['current_team_id' => $otherTeam->id])->save();
+
+        $this->actingAs($owner)->delete(route('teams.destroy', $team));
+
+        $this->assertSame($ownerPersonalTeam->id, $owner->fresh()->current_team_id);
+        $this->assertSame($memberPersonalTeam->id, $member->fresh()->current_team_id);
+        $this->assertSame($otherTeam->id, $otherMember->fresh()->current_team_id);
+    }
+
+    public function test_admins_cannot_delete_the_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+
+        $this->actingAs($admin)
+            ->delete(route('teams.destroy', $team))
+            ->assertForbidden();
+
+        $this->assertModelExists($team);
+    }
+
+    public function test_admins_cannot_delete_the_team_even_when_granted_every_permission()
+    {
+        config(['teams.roles.admin.permissions' => ['*']]);
+
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+
+        $this->actingAs($admin)
+            ->delete(route('teams.destroy', $team))
+            ->assertForbidden();
+
+        $this->assertModelExists($team);
+    }
+
+    public function test_members_cannot_delete_the_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($member)
+            ->delete(route('teams.destroy', $team))
+            ->assertForbidden();
+
+        $this->assertModelExists($team);
+    }
+
+    public function test_outsiders_cannot_delete_the_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+
+        $this->actingAs(User::factory()->withPersonalTeam()->create())
+            ->delete(route('teams.destroy', $team))
+            ->assertForbidden();
+
+        $this->assertModelExists($team);
+    }
+
+    public function test_guests_are_redirected_to_the_login_page()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+
+        $this->delete(route('teams.destroy', $team))
+            ->assertRedirect(route('login'));
+
+        $this->assertModelExists($team);
+    }
+
+    public function test_personal_teams_cannot_be_deleted()
+    {
+        $owner = User::factory()->withPersonalTeam()->create();
+        /** @var Team $personalTeam */
+        $personalTeam = $owner->fresh()->currentTeam;
+
+        $this->actingAs($owner)
+            ->delete(route('teams.destroy', $personalTeam))
+            ->assertForbidden();
+
+        $this->assertModelExists($personalTeam);
+        $this->assertTrue($owner->belongsToTeam($personalTeam));
+    }
+
+    public function test_only_owners_of_non_personal_teams_see_the_delete_option()
+    {
+        $owner = User::factory()->withPersonalTeam()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+        $admin->forceFill(['current_team_id' => $team->id])->save();
+
+        $this->actingAs($owner)
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page->where('can.deleteTeam', true));
+
+        $this->actingAs($admin)
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page->where('can.deleteTeam', false));
+
+        $owner->forceFill(['current_team_id' => $owner->teams()->where('personal_team', true)->value('teams.id')])->save();
+
+        $this->actingAs($owner->fresh())
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page->where('can.deleteTeam', false));
+    }
+}
