@@ -0,0 +1,32 @@
+<?php
+
+namespace App\Actions\Teams;
+
+use App\Models\Team;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class LeaveTeam
+{
+    /**
+     * Remove the user from a team they chose to leave.
+     *
+     * A user who was working in the team is moved to another team they
+     * belong to, preferring their personal team.
+     */
+    public function handle(User $user, Team $team): void
+    {
+        DB::transaction(function () use ($user, $team) {
+            $team->members()->detach($user->id);
+
+            if ($user->isCurrentTeam($team)) {
+                $fallbackTeam = $user->teams()
+                    ->orderByDesc('personal_team')
+                    ->orderBy('teams.id')
+                    ->first();
+
+                $user->forceFill(['current_team_id' => $fallbackTeam?->id])->save();
+            }
+        });
+    }
+}
