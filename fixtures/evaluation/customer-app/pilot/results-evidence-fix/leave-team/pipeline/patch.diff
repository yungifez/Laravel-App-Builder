 namespace App\Policies;
 
+use App\Enums\TeamRole;
 use App\Models\Team;
 use App\Models\User;
 
@@ -38,4 +39,18 @@ public function removeMember(User $user, Team $team): bool
     {
         return $user->hasTeamPermission($team, 'members:remove');
     }
+
+    /**
+     * Determine whether the user can leave the team.
+     *
+     * The owner cannot leave the team they own, and nobody can leave a personal team.
+     */
+    public function leave(User $user, Team $team): bool
+    {
+        $role = $user->teamRole($team);
+
+        return $role !== null
+            && $role !== TeamRole::Owner
+            && ! $team->personal_team;
+    }
 }
