diff --git a/tests/Feature/Teams/LeaveTeamTest.php b/tests/Feature/Teams/LeaveTeamTest.php
new file mode 100644
index 0000000..1416d59
--- /dev/null
+++ b/tests/Feature/Teams/LeaveTeamTest.php
@@ -0,0 +1,172 @@
+<?php
+
+namespace Tests\Feature\Teams;
+
+use App\Enums\TeamRole;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Inertia\Testing\AssertableInertia as Assert;
+use Tests\Concerns\InteractsWithTeams;
+use Tests\TestCase;
+
+class LeaveTeamTest extends TestCase
+{
+    use InteractsWithTeams, RefreshDatabase;
+
+    public function test_members_can_leave_a_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($member)
+            ->delete(route('team-membership.destroy', $team))
+            ->assertSessionHasNoErrors()
+            ->assertRedirect(route('dashboard'))
+            ->assertInertiaFlash('toast.type', 'success');
+
+        $this->assertFalse($member->belongsToTeam($team));
+        $this->assertFalse($team->hasMember($member));
+    }
+
+    public function test_admins_can_leave_a_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+
+        $this->actingAs($admin)
+            ->delete(route('team-membership.destroy', $team))
+            ->assertRedirect(route('dashboard'));
+
+        $this->assertFalse($admin->belongsToTeam($team));
+    }
+
+    public function test_leaving_the_current_team_moves_the_user_to_their_personal_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $personalTeam = $member->currentTeam;
+        $member->forceFill(['current_team_id' => $team->id])->save();
+
+        $this->actingAs($member)->delete(route('team-membership.destroy', $team));
+
+        $this->assertSame($personalTeam->id, $member->fresh()->current_team_id);
+    }
+
+    public function test_leaving_another_team_keeps_the_current_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $personalTeam = $member->currentTeam;
+
+        $this->actingAs($member)->delete(route('team-membership.destroy', $team));
+
+        $this->assertSame($personalTeam->id, $member->fresh()->current_team_id);
+    }
+
+    public function test_a_user_cannot_switch_to_a_team_they_left()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($member)->delete(route('team-membership.destroy', $team));
+
+        $this->actingAs($member->fresh())
+            ->put(route('current-team.update', $team))
+            ->assertForbidden();
+    }
+
+    public function test_the_owner_cannot_leave_their_team()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+
+        $this->actingAs($owner)
+            ->delete(route('team-membership.destroy', $team))
+            ->assertForbidden();
+
+        $this->assertSame(TeamRole::Owner, $owner->teamRole($team));
+    }
+
+    public function test_a_personal_team_cannot_be_left()
+    {
+        $user = User::factory()->withPersonalTeam()->create();
+        $personalTeam = $user->fresh()->currentTeam;
+
+        $this->actingAs($user)
+            ->delete(route('team-membership.destroy', $personalTeam))
+            ->assertForbidden();
+
+        $this->assertTrue($user->belongsToTeam($personalTeam));
+    }
+
+    public function test_non_members_cannot_leave_a_team()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $outsider = User::factory()->withPersonalTeam()->create();
+
+        $this->actingAs($outsider)
+            ->delete(route('team-membership.destroy', $team))
+            ->assertForbidden();
+
+        $this->assertSame(2, $team->members()->count());
+        $this->assertTrue($member->belongsToTeam($team));
+    }
+
+    public function test_guests_are_redirected_to_the_login_page()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+
+        $this->delete(route('team-membership.destroy', $team))
+            ->assertRedirect(route('login'));
+
+        $this->assertSame(1, $team->members()->count());
+    }
+
+    public function test_leaving_only_removes_the_user_making_the_request()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $other = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($member)->delete(route('team-membership.destroy', $team));
+
+        $this->assertFalse($member->belongsToTeam($team));
+        $this->assertSame(TeamRole::Owner, $owner->teamRole($team));
+        $this->assertSame(TeamRole::Admin, $admin->teamRole($team));
+        $this->assertSame(TeamRole::Member, $other->teamRole($team));
+    }
+
+    public function test_the_settings_page_lets_members_leave()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $member->forceFill(['current_team_id' => $team->id])->save();
+
+        $this->actingAs($member)
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page->where('canLeave', true));
+    }
+
+    public function test_the_settings_page_hides_leaving_from_the_owner()
+    {
+        $owner = User::factory()->create();
+        $this->createTeamOwnedBy($owner);
+
+        $this->actingAs($owner)
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page->where('canLeave', false));
+    }
+
+    public function test_the_settings_page_hides_leaving_on_a_personal_team()
+    {
+        $user = User::factory()->withPersonalTeam()->create();
+
+        $this->actingAs($user)
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page->where('canLeave', false));
+    }
+}
