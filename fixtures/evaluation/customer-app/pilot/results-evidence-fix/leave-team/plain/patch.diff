@@ -0,0 +1,29 @@
+<?php
+
+namespace App\Http\Controllers\Settings;
+
+use App\Actions\Teams\LeaveTeam;
+use App\Http\Controllers\Controller;
+use App\Http\Requests\Settings\TeamMembershipDestroyRequest;
+use App\Models\Team;
+use Illuminate\Http\RedirectResponse;
+use Inertia\Inertia;
+
+class TeamMembershipController extends Controller
+{
+    /**
+     * Leave the given team.
+     */
+    public function destroy(TeamMembershipDestroyRequest $request, Team $team, LeaveTeam $leaveTeam): RedirectResponse
+    {
+        $user = $request->user();
+
+        $leaveTeam->handle($team, $user);
+
+        Inertia::flash('toast', ['type' => 'success', 'message' => __('You left :team.', ['team' => $team->name])]);
+
+        return $user->current_team_id === null
+            ? to_route('dashboard')
+            : to_route('teams.edit');
+    }
+}
