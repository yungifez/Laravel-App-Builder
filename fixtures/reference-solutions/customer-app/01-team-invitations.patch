@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Actions\Teams\AcceptTeamInvitation;
+use App\Models\TeamInvitation;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Gate;
+use Inertia\Inertia;
+use Symfony\Component\HttpFoundation\Response;
+
+class TeamInvitationAcceptanceController extends Controller
+{
+    /**
+     * Show the invitation so the invitee can accept it, or explain why they cannot.
+     */
+    public function show(Request $request, string $token): Response
+    {
+        $invitation = TeamInvitation::findByToken($token);
+
+        [$state, $status] = match (true) {
+            $invitation === null => ['invalid', 404],
+            $invitation->isExpired() => ['expired', 410],
+            ! $request->user()->can('accept', $invitation) => ['wrong-user', 403],
+            default => ['pending', 200],
+        };
+
+        return Inertia::render('team-invitations/Show', [
+            'state' => $state,
+            'token' => $state === 'pending' ? $token : null,
+            'invitation' => $state === 'invalid' || $invitation === null ? null : [
+                'team' => $invitation->team->name,
+                'role_label' => $invitation->role->label(),
+                'email' => $state === 'wrong-user' ? null : $invitation->email,
+            ],
+        ])->toResponse($request)->setStatusCode($status);
+    }
+
+    /**
+     * Accept the invitation.
+     */
+    public function store(Request $request, string $token, AcceptTeamInvitation $acceptTeamInvitation): RedirectResponse
+    {
+        $invitation = TeamInvitation::findByToken($token);
+
+        abort_if($invitation === null, 404);
+        abort_if($invitation->isExpired(), 410, __('This invitation has expired.'));
+
+        Gate::authorize('accept', $invitation);
+
+        $team = $acceptTeamInvitation->handle($request->user(), $invitation);
+
+        Inertia::flash('toast', ['type' => 'success', 'message' => __('You joined :team.', ['team' => $team->name])]);
+
+        return to_route('teams.edit');
+    }
+}
