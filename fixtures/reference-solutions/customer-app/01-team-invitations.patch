+<?php
+
+namespace Tests\Feature\Teams;
+
+use App\Actions\Teams\AcceptTeamInvitation;
+use App\Enums\TeamRole;
+use App\Models\TeamInvitation;
+use App\Models\User;
+use App\Notifications\TeamInvitationNotification;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Notifications\AnonymousNotifiable;
+use Inertia\Testing\AssertableInertia as Assert;
+use Tests\Concerns\InteractsWithTeams;
+use Tests\TestCase;
+
+class AcceptTeamInvitationTest extends TestCase
+{
+    use InteractsWithTeams, RefreshDatabase;
+
+    public function test_the_invited_person_can_view_and_accept_the_invitation()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        TeamInvitation::factory()->for($team)->withToken('secret-token')->create(['email' => 'new@example.com', 'role' => TeamRole::Admin]);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->actingAs($invitee)
+            ->get(route('team-invitations.show', 'secret-token'))
+            ->assertOk()
+            ->assertInertia(fn (Assert $page) => $page
+                ->component('team-invitations/Show')
+                ->where('state', 'pending')
+                ->where('invitation.team', 'Acme'));
+
+        $this->actingAs($invitee)
+            ->post(route('team-invitations.accept', 'secret-token'))
+            ->assertRedirect(route('teams.edit'));
+
+        $this->assertSame(TeamRole::Admin, $invitee->teamRole($team));
+        $this->assertSame($team->id, $invitee->fresh()->current_team_id);
+        $this->assertSame(0, $team->invitations()->count());
+    }
+
+    public function test_an_invitation_can_only_be_used_once()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        TeamInvitation::factory()->for($team)->withToken('secret-token')->create(['email' => 'new@example.com']);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->actingAs($invitee)->post(route('team-invitations.accept', 'secret-token'));
+        $this->actingAs($invitee)->post(route('team-invitations.accept', 'secret-token'))->assertNotFound();
+
+        $this->assertSame(1, $team->members()->whereKey($invitee->id)->count());
+    }
+
+    public function test_a_second_simultaneous_acceptance_finds_the_invitation_gone()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $invitation = TeamInvitation::factory()->for($team)->create(['email' => 'new@example.com']);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+        $staleCopy = TeamInvitation::query()->findOrFail($invitation->id);
+
+        app(AcceptTeamInvitation::class)->handle($invitee, $invitation);
+
+        $this->expectException(ModelNotFoundException::class);
+
+        try {
+            app(AcceptTeamInvitation::class)->handle($invitee, $staleCopy);
+        } finally {
+            $this->assertSame(1, $team->members()->whereKey($invitee->id)->count());
+        }
+    }
+
+    public function test_someone_else_cannot_accept_the_invitation()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        TeamInvitation::factory()->for($team)->withToken('secret-token')->create(['email' => 'new@example.com']);
+        $stranger = User::factory()->withPersonalTeam()->create();
+
+        $this->actingAs($stranger)
+            ->get(route('team-invitations.show', 'secret-token'))
+            ->assertForbidden()
+            ->assertInertia(fn (Assert $page) => $page->where('state', 'wrong-user')->where('invitation.email', null));
+
+        $this->actingAs($stranger)->post(route('team-invitations.accept', 'secret-token'))->assertForbidden();
+
+        $this->assertFalse($stranger->belongsToTeam($team));
+        $this->assertSame(1, $team->invitations()->count());
+    }
+
+    public function test_expired_invitations_cannot_be_accepted()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        TeamInvitation::factory()->for($team)->withToken('secret-token')->create(['email' => 'new@example.com']);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->travel(8)->days();
+
+        $this->actingAs($invitee)
+            ->get(route('team-invitations.show', 'secret-token'))
+            ->assertStatus(410)
+            ->assertInertia(fn (Assert $page) => $page->where('state', 'expired'));
+
+        $this->actingAs($invitee)->post(route('team-invitations.accept', 'secret-token'))->assertStatus(410);
+
+        $this->assertFalse($invitee->belongsToTeam($team));
+    }
+
+    public function test_cancelled_and_unknown_tokens_are_invalid()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $invitation = TeamInvitation::factory()->for($team)->withToken('secret-token')->create(['email' => 'new@example.com']);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->actingAs($owner)->delete(route('team-invitations.destroy', [$team, $invitation]));
+
+        $this->actingAs($invitee)
+            ->get(route('team-invitations.show', 'secret-token'))
+            ->assertNotFound()
+            ->assertInertia(fn (Assert $page) => $page->where('state', 'invalid'));
+        $this->actingAs($invitee)->post(route('team-invitations.accept', 'secret-token'))->assertNotFound();
+        $this->actingAs($invitee)->post(route('team-invitations.accept', 'made-up'))->assertNotFound();
+
+        $this->assertFalse($invitee->belongsToTeam($team));
+    }
+
+    public function test_guests_are_asked_to_log_in_first()
+    {
+        TeamInvitation::factory()->withToken('secret-token')->create();
+
+        $this->get(route('team-invitations.show', 'secret-token'))->assertRedirect(route('login'));
+        $this->post(route('team-invitations.accept', 'secret-token'))->assertRedirect(route('login'));
+    }
+
+    public function test_unverified_users_must_verify_their_email_first()
+    {
+        TeamInvitation::factory()->withToken('secret-token')->create(['email' => 'new@example.com']);
+        $invitee = User::factory()->unverified()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->actingAs($invitee)
+            ->post(route('team-invitations.accept', 'secret-token'))
+            ->assertRedirect(route('verification.notice'));
+    }
+
+    public function test_the_invitation_email_links_to_the_invitation_page()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create(), 'Acme');
+        $invitation = TeamInvitation::factory()->for($team)->create(['role' => TeamRole::Member]);
+
+        $mail = (new TeamInvitationNotification($invitation, 'secret-token'))->toMail(new AnonymousNotifiable);
+
+        $this->assertSame('Invitation to join Acme', $mail->subject);
+        $this->assertSame(route('team-invitations.show', 'secret-token'), $mail->actionUrl);
+        $this->assertStringContainsString('as Member', implode(' ', $mail->introLines));
+    }
+}
