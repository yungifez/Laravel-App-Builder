+<script setup lang="ts">
+import { Form, Head, Link } from '@inertiajs/vue3';
+import TeamInvitationAcceptanceController from '@/actions/App/Http/Controllers/TeamInvitationAcceptanceController';
+import Heading from '@/components/Heading.vue';
+import { Alert, AlertDescription, AlertTitle } from '@/components/ui/alert';
+import { Button } from '@/components/ui/button';
+import { dashboard } from '@/routes';
+
+defineProps<{
+    state: 'pending' | 'expired' | 'invalid' | 'wrong-user';
+    token: string | null;
+    invitation: {
+        team: string;
+        role_label: string;
+        email: string | null;
+    } | null;
+}>();
+</script>
+
+<template>
+    <Head title="Team invitation" />
+
+    <div class="flex h-full flex-1 flex-col gap-6 p-4">
+        <div class="max-w-xl space-y-6">
+            <Heading
+                title="Team invitation"
+                :description="
+                    invitation
+                        ? `Invitation to join ${invitation.team} as ${invitation.role_label}`
+                        : undefined
+                "
+            />
+
+            <Form
+                v-if="state === 'pending' && token"
+                v-bind="TeamInvitationAcceptanceController.store.form(token)"
+                class="space-y-4"
+                v-slot="{ processing }"
+            >
+                <p class="text-sm text-muted-foreground">
+                    Accepting adds {{ invitation?.email }} to the team. The
+                    invitation link then stops working.
+                </p>
+                <Button
+                    :disabled="processing"
+                    data-test="accept-invitation-button"
+                >
+                    Accept invitation
+                </Button>
+            </Form>
+
+            <Alert v-else variant="destructive" role="alert">
+                <AlertTitle v-if="state === 'expired'">
+                    This invitation has expired
+                </AlertTitle>
+                <AlertTitle v-else-if="state === 'wrong-user'">
+                    This invitation is for a different account
+                </AlertTitle>
+                <AlertTitle v-else>This invitation is not valid</AlertTitle>
+                <AlertDescription>
+                    <template v-if="state === 'expired'">
+                        Ask the team owner to send you a new invitation.
+                    </template>
+                    <template v-else-if="state === 'wrong-user'">
+                        Sign in with the email address the invitation was sent
+                        to.
+                    </template>
+                    <template v-else>
+                        It may have been used already or cancelled.
+                    </template>
+                </AlertDescription>
+            </Alert>
+
+            <Link
+                :href="dashboard()"
+                class="text-sm underline underline-offset-4"
+            >
+                Go to your dashboard
+            </Link>
+        </div>
+    </div>
+</template>
