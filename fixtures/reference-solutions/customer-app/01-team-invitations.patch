+<?php
+
+namespace App\Actions\Teams;
+
+use App\Enums\TeamRole;
+use App\Models\Team;
+use App\Models\TeamInvitation;
+use App\Notifications\TeamInvitationNotification;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class InviteTeamMember
+{
+    /**
+     * Invite someone to join the team with the given role.
+     *
+     * The invitation is stored in a transaction and the email is queued to go
+     * out after it commits. An expired invitation for the same address is
+     * replaced. A concurrent duplicate is rejected by the database's unique
+     * index and reported as a validation error without a second email.
+     *
+     * @throws ValidationException
+     */
+    public function handle(Team $team, string $email, TeamRole $role): TeamInvitation
+    {
+        $token = Str::random(64);
+
+        try {
+            $invitation = DB::transaction(function () use ($team, $email, $role, $token) {
+                $team->invitations()->where('email', $email)->where('expires_at', '<=', now())->delete();
+
+                $invitation = $team->invitations()->create([
+                    'email' => $email,
+                    'role' => $role,
+                    'token_hash' => TeamInvitation::hashToken($token),
+                    'expires_at' => now()->addDays((int) config('teams.invitations.expires_after_days')),
+                ]);
+
+                Notification::route('mail', $email)->notify(new TeamInvitationNotification($invitation, $token));
+
+                return $invitation;
+            });
+        } catch (UniqueConstraintViolationException) {
+            throw ValidationException::withMessages([
+                'email' => __('This person has already been invited to the team.'),
+            ]);
+        }
+
+        return $invitation;
+    }
+}
