+<?php
+
+namespace App\Notifications;
+
+use App\Models\TeamInvitation;
+use Illuminate\Bus\Queueable;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Notifications\Messages\MailMessage;
+use Illuminate\Notifications\Notification;
+
+/**
+ * Emails the invitation link. It is queued and only dispatched after the
+ * surrounding database transaction commits, so a rolled-back invitation never
+ * sends mail. Delivery retries follow the queue's retry settings; delivery is
+ * at least once, not exactly once.
+ */
+class TeamInvitationNotification extends Notification implements ShouldQueue
+{
+    use Queueable;
+
+    /**
+     * Create a new notification instance.
+     */
+    public function __construct(public TeamInvitation $invitation, public string $token)
+    {
+        $this->afterCommit();
+    }
+
+    /**
+     * Get the notification's delivery channels.
+     *
+     * @return array<int, string>
+     */
+    public function via(object $notifiable): array
+    {
+        return ['mail'];
+    }
+
+    /**
+     * Get the mail representation of the notification.
+     */
+    public function toMail(object $notifiable): MailMessage
+    {
+        $teamName = $this->invitation->team->name;
+
+        return (new MailMessage)
+            ->subject(__('Invitation to join :team', ['team' => $teamName]))
+            ->line(__('You have been invited to join the :team team as :role.', [
+                'team' => $teamName,
+                'role' => $this->invitation->role->label(),
+            ]))
+            ->line(__('If you do not have an account yet, register with this email address first.'))
+            ->action(__('View invitation'), route('team-invitations.show', $this->token))
+            ->line(__('This invitation can be used once and expires on :date. If you did not expect it, you can ignore this email.', [
+                'date' => $this->invitation->expires_at->toFormattedDayDateString(),
+            ]));
+    }
+}
