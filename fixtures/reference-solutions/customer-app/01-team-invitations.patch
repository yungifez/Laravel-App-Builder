diff --git a/tests/Feature/Teams/AcceptTeamInvitationTest.php b/tests/Feature/Teams/AcceptTeamInvitationTest.php
new file mode 100644
index 0000000..2c6125c
--- /dev/null
+++ b/tests/Feature/Teams/AcceptTeamInvitationTest.php
@@ -0,0 +1,84 @@
+<?php
+
+namespace Tests\Feature\Teams;
+
+use App\Enums\TeamRole;
+use App\Mail\TeamInvitationMail;
+use App\Models\TeamInvitation;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\URL;
+use Tests\Concerns\InteractsWithTeams;
+use Tests\TestCase;
+
+class AcceptTeamInvitationTest extends TestCase
+{
+    use InteractsWithTeams, RefreshDatabase;
+
+    public function test_the_invited_person_can_accept_the_invitation()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $invitation = TeamInvitation::factory()->for($team)->create(['email' => 'new@example.com', 'role' => TeamRole::Admin]);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->actingAs($invitee)
+            ->get($this->acceptUrl($invitation))
+            ->assertRedirect(route('teams.edit'));
+
+        $this->assertSame(TeamRole::Admin, $invitee->teamRole($team));
+        $this->assertSame($team->id, $invitee->fresh()->current_team_id);
+        $this->assertModelMissing($invitation);
+    }
+
+    public function test_someone_else_cannot_accept_the_invitation()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $invitation = TeamInvitation::factory()->for($team)->create(['email' => 'new@example.com']);
+        $stranger = User::factory()->withPersonalTeam()->create();
+
+        $this->actingAs($stranger)
+            ->get($this->acceptUrl($invitation))
+            ->assertForbidden();
+
+        $this->assertFalse($stranger->belongsToTeam($team));
+        $this->assertModelExists($invitation);
+    }
+
+    public function test_the_link_must_be_signed()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $invitation = TeamInvitation::factory()->for($team)->create(['email' => 'new@example.com']);
+        $invitee = User::factory()->withPersonalTeam()->create(['email' => 'new@example.com']);
+
+        $this->actingAs($invitee)
+            ->get(route('team-invitations.accept', $invitation))
+            ->assertForbidden();
+
+        $this->assertFalse($invitee->belongsToTeam($team));
+    }
+
+    public function test_guests_are_asked_to_log_in_first()
+    {
+        $invitation = TeamInvitation::factory()->create();
+
+        $this->get($this->acceptUrl($invitation))->assertRedirect(route('login'));
+    }
+
+    public function test_the_invitation_email_links_to_the_signed_acceptance_url()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create(), 'Acme');
+        $invitation = TeamInvitation::factory()->for($team)->create(['role' => TeamRole::Member]);
+
+        $mail = new TeamInvitationMail($invitation);
+
+        $mail->assertHasSubject('Invitation to join Acme');
+        $mail->assertSeeInHtml('as Member', false);
+        $mail->assertSeeInHtml(route('team-invitations.accept', $invitation), false);
+        $mail->assertSeeInHtml('signature=', false);
+    }
+
+    protected function acceptUrl(TeamInvitation $invitation): string
+    {
+        return URL::signedRoute('team-invitations.accept', $invitation);
+    }
+}
diff --git a/tests/Feature/Teams/InviteTeamMemberTest.php b/tests/Feature/Teams/InviteTeamMemberTest.php
new file mode 100644
index 0000000..785f176
--- /dev/null
+++ b/tests/Feature/Teams/InviteTeamMemberTest.php
@@ -0,0 +1,156 @@
+<?php
+
+namespace Tests\Feature\Teams;
+
+use App\Enums\TeamRole;
+use App\Mail\TeamInvitationMail;
+use App\Models\TeamInvitation;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+use Inertia\Testing\AssertableInertia as Assert;
+use Tests\Concerns\InteractsWithTeams;
+use Tests\TestCase;
+
+class InviteTeamMemberTest extends TestCase
+{
+    use InteractsWithTeams, RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        Mail::fake();
+    }
+
+    public function test_owners_can_invite_people_to_the_team()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+
+        $this->actingAs($owner)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'admin'])
+            ->assertSessionHasNoErrors()
+            ->assertRedirect(route('teams.edit'));
+
+        $invitation = $team->invitations()->sole();
+
+        $this->assertSame('new@example.com', $invitation->email);
+        $this->assertSame(TeamRole::Admin, $invitation->role);
+
+        Mail::assertSent(TeamInvitationMail::class, fn (TeamInvitationMail $mail) => $mail->hasTo('new@example.com')
+            && $mail->invitation->is($invitation));
+    }
+
+    public function test_admins_can_invite_people_to_the_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+
+        $this->actingAs($admin)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertSessionHasNoErrors();
+
+        $this->assertTrue($team->invitations()->where('email', 'new@example.com')->exists());
+    }
+
+    public function test_members_cannot_invite_people()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($member)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertForbidden();
+
+        $this->assertSame(0, $team->invitations()->count());
+        Mail::assertNothingSent();
+    }
+
+    public function test_existing_members_cannot_be_invited()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $member = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($owner)
+            ->post(route('team-invitations.store', $team), ['email' => $member->email, 'role' => 'member'])
+            ->assertSessionHasErrors('email');
+    }
+
+    public function test_people_cannot_be_invited_twice()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        TeamInvitation::factory()->for($team)->create(['email' => 'new@example.com']);
+
+        $this->actingAs($owner)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertSessionHasErrors('email');
+    }
+
+    public function test_the_owner_role_cannot_be_offered()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+
+        $this->actingAs($owner)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'owner'])
+            ->assertSessionHasErrors('role');
+    }
+
+    public function test_the_team_page_lists_pending_invitations_for_people_who_can_invite()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        TeamInvitation::factory()->for($team)->create(['email' => 'new@example.com']);
+
+        $this->actingAs($owner)
+            ->get(route('teams.edit'))
+            ->assertInertia(fn (Assert $page) => $page
+                ->where('can.inviteMembers', true)
+                ->has('invitations', 1)
+                ->where('invitations.0.email', 'new@example.com')
+                ->where('invitations.0.role', 'member')
+            );
+    }
+
+    public function test_owners_can_cancel_invitations()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $invitation = TeamInvitation::factory()->for($team)->create();
+
+        $this->actingAs($owner)
+            ->delete(route('team-invitations.destroy', [$team, $invitation]))
+            ->assertRedirect(route('teams.edit'));
+
+        $this->assertModelMissing($invitation);
+    }
+
+    public function test_members_cannot_cancel_invitations()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+        $invitation = TeamInvitation::factory()->for($team)->create();
+
+        $this->actingAs($member)
+            ->delete(route('team-invitations.destroy', [$team, $invitation]))
+            ->assertForbidden();
+
+        $this->assertModelExists($invitation);
+    }
+
+    public function test_invitations_of_other_teams_cannot_be_cancelled()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $otherInvitation = TeamInvitation::factory()->create();
+
+        $this->actingAs($owner)
+            ->delete(route('team-invitations.destroy', [$team, $otherInvitation]))
+            ->assertNotFound();
+
+        $this->assertModelExists($otherInvitation);
+    }
+}
