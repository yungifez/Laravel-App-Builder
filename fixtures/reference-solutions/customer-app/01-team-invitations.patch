@@ -0,0 +1,40 @@
+<?php
+
+namespace App\Actions\Teams;
+
+use App\Models\Team;
+use App\Models\TeamInvitation;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Support\Facades\DB;
+
+class AcceptTeamInvitation
+{
+    /**
+     * Add the user to the invitation's team with the invited role, make it
+     * their current team and consume the invitation.
+     *
+     * The invitation row is locked for the duration of the transaction, so of
+     * two simultaneous acceptances only one succeeds; the other finds the
+     * invitation gone.
+     *
+     * @throws ModelNotFoundException when the invitation was already used or cancelled.
+     */
+    public function handle(User $user, TeamInvitation $invitation): Team
+    {
+        return DB::transaction(function () use ($user, $invitation) {
+            $invitation = TeamInvitation::query()->lockForUpdate()->findOrFail($invitation->id);
+            $team = $invitation->team;
+
+            if (! $user->belongsToTeam($team)) {
+                $team->members()->attach($user, ['role' => $invitation->role->value]);
+            }
+
+            $user->forceFill(['current_team_id' => $team->id])->save();
+
+            $invitation->delete();
+
+            return $team;
+        });
+    }
+}
