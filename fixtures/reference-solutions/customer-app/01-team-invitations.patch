+use Illuminate\Validation\ValidationException;
+use Inertia\Testing\AssertableInertia as Assert;
+use Tests\Concerns\InteractsWithTeams;
+use Tests\TestCase;
+
+class InviteTeamMemberTest extends TestCase
+{
+    use InteractsWithTeams, RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+
+        Notification::fake();
+    }
+
+    public function test_owners_can_invite_people_to_the_team()
+    {
+        $owner = User::factory()->create();
+        $team = $this->createTeamOwnedBy($owner);
+        $this->freezeSecond();
+
+        $this->actingAs($owner)
+            ->post(route('team-invitations.store', $team), ['email' => '  New@Example.COM ', 'role' => 'admin'])
+            ->assertSessionHasNoErrors()
+            ->assertRedirect(route('teams.edit'));
+
+        $invitation = $team->invitations()->sole();
+
+        $this->assertSame('new@example.com', $invitation->email);
+        $this->assertSame(TeamRole::Admin, $invitation->role);
+        $this->assertTrue($invitation->expires_at->equalTo(now()->addDays(7)));
+        $this->assertFalse($team->members()->where('email', 'new@example.com')->exists());
+
+        Notification::assertSentOnDemand(
+            TeamInvitationNotification::class,
+            function (TeamInvitationNotification $notification, array $channels, AnonymousNotifiable $notifiable) use ($invitation) {
+                return $notifiable->routes['mail'] === 'new@example.com'
+                    && $notification->invitation->is($invitation)
+                    && TeamInvitation::hashToken($notification->token) === $invitation->token_hash
+                    && $invitation->token_hash !== $notification->token;
+            },
+        );
+    }
+
+    public function test_admins_can_invite_people_to_the_team()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $admin = $this->addTeamMember($team, TeamRole::Admin);
+
+        $this->actingAs($admin)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertSessionHasNoErrors();
+
+        $this->assertTrue($team->invitations()->where('email', 'new@example.com')->exists());
+    }
+
+    public function test_members_cannot_invite_people()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $member = $this->addTeamMember($team, TeamRole::Member);
+
+        $this->actingAs($member)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertForbidden();
+
+        $this->assertSame(0, $team->invitations()->count());
+        Notification::assertNothingSent();
+    }
+
+    public function test_owners_of_other_teams_cannot_invite_people()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+        $otherOwner = User::factory()->create();
+        $this->createTeamOwnedBy($otherOwner, 'Other');
+
+        $this->actingAs($otherOwner)
+            ->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertForbidden();
+
+        $this->assertSame(0, $team->invitations()->count());
+    }
+
+    public function test_guests_cannot_invite_people()
+    {
+        $team = $this->createTeamOwnedBy(User::factory()->create());
+
+        $this->post(route('team-invitations.store', $team), ['email' => 'new@example.com', 'role' => 'member'])
+            ->assertRedirect(route('login'));
+
+        $this->assertSame(0, $team->invitations()->count());
+    }
+
+    public function test_invalid_input_writes_nothing()
