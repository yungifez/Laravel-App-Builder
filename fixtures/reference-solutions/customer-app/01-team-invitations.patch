+<?php
+
+namespace App\Policies;
+
+use App\Models\TeamInvitation;
+use App\Models\User;
+
+class TeamInvitationPolicy
+{
+    /**
+     * Determine whether the user can accept the invitation.
+     *
+     * Only the person the invitation was sent to may accept it.
+     */
+    public function accept(User $user, TeamInvitation $invitation): bool
+    {
+        return strcasecmp($user->email, $invitation->email) === 0;
+    }
+}
