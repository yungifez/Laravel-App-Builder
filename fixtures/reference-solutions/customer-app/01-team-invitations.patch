+<?php
+
+namespace App\Http\Controllers\Settings;
+
+use App\Actions\Teams\CancelTeamInvitation;
+use App\Actions\Teams\InviteTeamMember;
+use App\Enums\TeamRole;
+use App\Http\Controllers\Controller;
+use App\Http\Requests\Settings\TeamInvitationDestroyRequest;
+use App\Http\Requests\Settings\TeamInvitationStoreRequest;
+use App\Models\Team;
+use App\Models\TeamInvitation;
+use Illuminate\Http\RedirectResponse;
+use Inertia\Inertia;
+
+class TeamInvitationController extends Controller
+{
+    /**
+     * Invite someone to the team.
+     */
+    public function store(TeamInvitationStoreRequest $request, Team $team, InviteTeamMember $inviteTeamMember): RedirectResponse
+    {
+        $inviteTeamMember->handle(
+            $team,
+            $request->validated('email'),
+            TeamRole::from($request->validated('role')),
+        );
+
+        Inertia::flash('toast', ['type' => 'success', 'message' => __('Invitation sent.')]);
+
+        return to_route('teams.edit');
+    }
+
+    /**
+     * Cancel a pending invitation.
+     */
+    public function destroy(TeamInvitationDestroyRequest $request, Team $team, TeamInvitation $invitation, CancelTeamInvitation $cancelTeamInvitation): RedirectResponse
+    {
+        $cancelTeamInvitation->handle($invitation);
+
+        Inertia::flash('toast', ['type' => 'success', 'message' => __('Invitation cancelled.')]);
+
+        return to_route('teams.edit');
+    }
+}
